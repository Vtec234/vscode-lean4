export function WidgetDemo() {
	const ec = React.useContext(EditorContext);
    const [curLoc, setCurLoc] = React.useState<Location>(ec.events.changedCursorLocation.current!);
    useEvent(ec.events.changedCursorLocation, setCurLoc, []);

    const curPos: DocumentPosition = { uri: curLoc.uri, ...curLoc.range.start };

    const [goals, setGoals] = React.useState<SubsetsGoal[]>([]);
    React.useEffect(() => {
        ec.api.sendClientRequest('$/lean/subsetsGoal', DocumentPosition.toTdpp(curPos))
        .then((val: SubsetsGoal[]) => {
            if (val) setGoals(val);
        });
    }, [curLoc]);

    let goalEls = goals.map (g => {
        return <PenroseGoal key={g.jsCode} goal={g} />;
    });
    return <div>
        {goalEls}
    </div>;
}